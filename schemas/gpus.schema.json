{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gpus.schema.json",
  "title": "GPU catalog",
  "type": "object",
  "required": ["catalog_version", "collected_at", "gpus"],
  "properties": {
    "catalog_version": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}$" },
    "collected_at": { "type": "string", "format": "date" },
    "currency": { "type": "string" },
    "gpus": {
      "type": "array",
      "minItems": 15,
      "items": {
        "type": "object",
        "required": [
          "id", "vendor", "name", "vram_gb", "bandwidth_gbs", "tdp_w", "nvlink", "slots",
          "pcie_lanes", "fp8_tensor_cores", "class", "release_year", "unified_memory",
          "rocm_support", "bandwidth_source"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "vendor": { "type": "string" },
          "name": { "type": "string" },
          "vram_gb": { "type": "number", "exclusiveMinimum": 0 },
          "bandwidth_gbs": { "type": "number", "exclusiveMinimum": 0 },
          "tdp_w": { "type": "number", "exclusiveMinimum": 0 },
          "nvlink": { "type": "boolean" },
          "interconnect": { "enum": ["pcie", "nvlink", "infinity_fabric", "unified"] },
          "slots": { "type": "integer", "minimum": 0 },
          "pcie_lanes": { "type": "integer", "minimum": 0 },
          "fp8_tensor_cores": { "type": "boolean" },
          "class": { "enum": ["consumer", "prosumer", "datacenter"] },
          "release_year": { "type": "integer", "minimum": 2015, "maximum": 2030 },
          "unified_memory": { "type": "boolean" },
          "rocm_support": { "type": "boolean" },
          "xpu_support": { "type": "boolean" },
          "bandwidth_source": { "enum": ["official", "third_party", "computed"] },
          "price_usd": { "type": ["number", "null"], "minimum": 0 },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
