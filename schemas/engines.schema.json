{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "engines.schema.json",
  "title": "Engine catalog",
  "type": "object",
  "required": ["catalog_version", "collected_at", "engines"],
  "properties": {
    "catalog_version": { "type": "string" },
    "collected_at": { "type": "string", "format": "date" },
    "engines": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id", "name", "gpu_only", "offload_supported", "default_util_target", "overhead_gb",
          "supports_tp", "kv_bytes_per_elem", "quant_family", "notes"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "name": { "type": "string" },
          "gpu_only": { "type": "boolean" },
          "offload_supported": { "type": "boolean" },
          "default_util_target": { "type": "number", "minimum": 0.5, "maximum": 1 },
          "overhead_gb": { "type": "number", "minimum": 0 },
          "supports_tp": { "type": "boolean" },
          "kv_bytes_per_elem": { "type": "number", "exclusiveMinimum": 0 },
          "quant_family": { "enum": ["gpu", "gguf"] },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
