{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "models.schema.json",
  "title": "Model catalog",
  "type": "object",
  "required": ["catalog_version", "collected_at", "models"],
  "properties": {
    "catalog_version": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}$" },
    "collected_at": { "type": "string", "format": "date" },
    "models": {
      "type": "array",
      "minItems": 25,
      "items": {
        "type": "object",
        "required": [
          "id", "name", "vendor", "family", "moe", "params_total_b", "params_active_b",
          "n_layers", "n_kv_heads", "head_dim", "max_context", "license", "commercial_ok",
          "status", "release_year", "geometry_source"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
          "name": { "type": "string" },
          "vendor": { "type": "string" },
          "family": { "type": "string" },
          "moe": { "type": "boolean" },
          "params_total_b": { "type": "number", "exclusiveMinimum": 0 },
          "params_active_b": { "type": "number", "exclusiveMinimum": 0 },
          "n_layers": { "type": "integer", "minimum": 1 },
          "n_kv_heads": { "type": "integer", "minimum": 1 },
          "head_dim": { "type": "integer", "minimum": 16, "maximum": 1024 },
          "max_context": { "type": "integer", "minimum": 512, "maximum": 20000000 },
          "license": { "type": "string" },
          "commercial_ok": { "type": "boolean" },
          "status": { "enum": ["released", "announced"] },
          "release_year": { "type": "integer", "minimum": 2018, "maximum": 2030 },
          "geometry_source": { "type": "string" },
          "notes": { "type": "string" },
          "is_draft": { "type": "boolean" },
          "dspark_target_models": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
